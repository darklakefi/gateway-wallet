# Network configuration
# 0 - mainnet, 1 - testnet (bug), 2 - devnet
NETWORK=2

# SWAP
INPUT_AMOUNT=1000
MIN_OUT=1
TOKEN_X_MINT=TOKEN-X-MINT
TOKEN_Y_MINT=TOKEN-Y-MINT

# Wallet configuration
PRIVATE_KEY_BYTES="ARRAY_OF_BYTES"

# Gateway/RPC configuration
GATEWAY_HOST=<GATEWAY URL TO SUBMIT SWAP>
GATEWAY_PORT=<GATEWAY URL TO SUBMIT SIGNED TX>

RPC_URL=<RPC URL>

# LIQUIDITY
MAX_AMOUNT_X=1000
MAX_AMOUNT_Y=1000
AMOUNT_LP=2

# REF/LABEL
REF_CODE=<STRING>
LABEL=<STRING>